# Unipile
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_BASE_URL=https://api2.unipile.com:13239/api/v1
UNIPILE_ACCOUNT_ID=your_unipile_account_id_here

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Sheets
# Path to your service account JSON file
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
# The long ID from the sheet URL: /spreadsheets/d/<THIS_PART>/edit
SPREADSHEET_ID=your_spreadsheet_id_here
SHEET_NAME=Sheet1

# Apify
APIFY_API_TOKEN=your_apify_token_here
# e.g. apimaestro~linkedin-profile-scraper
APIFY_ACTOR_ID=your_actor_id_here

# Timing (seconds between each LinkedIn API call — keep these generous)
WAIT_BETWEEN_LEADS=45
WAIT_BEFORE_SEND=30

# Part 2 webhook server port
WEBHOOK_PORT=5000
